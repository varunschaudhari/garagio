{
  "expo": {
    "name": "Trimurti Garage",
    "slug": "garage-manager",
    "version": "1.0.10",
    "scheme": "garagemanager",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F4F6FA",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "in.trimurtiauto.garage",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF",
        "backgroundImage": "./assets/adaptive-background.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F4F6FA",
          "dark": {
            "backgroundColor": "#0F1115"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan part and rack QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C1272D"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "defaultServer": "https://trimurti.foreverstory.in"
    }
  }
}
