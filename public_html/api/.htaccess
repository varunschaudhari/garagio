# Garage Manager API

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep the Authorization header (some hosts drop it before PHP sees it)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Block internal folders and files
  RewriteRule ^(lib|routes|templates|cron|storage)(/|$) - [F,L]
  RewriteRule ^config(\.sample)?\.php$ - [F,L]

  # Everything else goes to the router
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule !mod_rewrite.c>
  # Without mod_rewrite the apps use index.php?r=/path
  <FilesMatch "^config(\.sample)?\.php$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
